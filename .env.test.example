# Copiar como .env.test (ignorado por git) para ejecutar las pruebas de integración
# Bottom-Up y Big Bang contra PostgreSQL LOCAL. Las suites crean y borran sus propias
# bases aisladas (crowdradar_pruebas_bottomup / crowdradar_pruebas_bigbang); el usuario
# necesita permiso CREATEDB. No se toca ninguna otra base.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
