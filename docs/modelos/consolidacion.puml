@startuml
title CrowdRadar — R01 + Sprint 3 local (no despliegue)
package "Flutter Android / Web" {
  [Pages / Components] as UI
  [Cubits y guardas de sesión] as State
  [Servicios HTTP / DTO] as Client
  UI --> State
  State --> Client
}
package "Express por capas" {
  [Rutas / JWT / Controladores] as HTTP
  [Servicios de negocio] as Services
  [Repositorios / transacciones] as Repos
  [RecoveryMailDelivery\nAdapter SMTP existente] as Mail
  HTTP --> Services
  Services --> Repos
  Services --> Mail
}
database "PostgreSQL\nusers / places / recovery\nsaturation_reports / report_karma_awards\nreport_validations / report_denunciations" as DB
Client --> HTTP : JSON + JWT
Repos --> DB : SQL parametrizado / locks
Mail --> [Brevo SMTP] : TLS (configuración privada)
note right of Mail
  Cola actual en memoria, no durable.
  No garantiza entrega/reintentos.
end note
note bottom of DB
  Migraciones CLI explícitas 001–007.
  Arranque solo SELECT/readiness.
  No Data API desde Flutter.
end note
@enduml

@startuml
title Sprint 3 — participación única y peso fijo
actor Ciudadano
participant ReportReviewPage as UI
participant RequestCubit as State
participant "API / JWT / ReportValidationService" as API
participant ReportValidationRepository as Repo
database PostgreSQL as DB
Ciudadano -> UI : confirmar/rechazar o denunciar
UI -> State : una acción pendiente
State -> API : POST Bearer + reporte + elección/motivo
API -> Repo : actor verificado, entrada validada
Repo -> DB : BEGIN / usuario FOR UPDATE
Repo -> DB : revalidar activo/versión/expiración\ncomprobar reporte activo y no propio
alt válido y primera participación
  Repo -> DB : INSERT voto + peso congelado\no denuncia (PK reporte/usuario)
  Repo -> DB : COMMIT
  Repo --> API : 201
  API --> State : éxito
  State -> API : recargar conteos/estado
else propio, duplicado o inválido
  Repo -> DB : sin cambios / ROLLBACK
  Repo --> API : 403 / 409 / error público
  API --> State : mensaje público
end
note over UI,State
  Sesión nueva/dispose invalida respuestas anteriores.
  Una denuncia no borra/oculta ni crea moderación HU7.
end note
@enduml

@startuml
title Sprint 3 — persistencia ciudadana (sin HU7/8)
entity users {
  * id : INTEGER <<PK>>
  karma_points : BIGINT
  sessionVersion : INTEGER
}
entity places {
  * id : INTEGER <<PK>>
  activo : BOOLEAN
}
entity saturation_reports {
  * id : BIGINT <<PK>>
  user_id : INTEGER <<FK>>
  place_id : INTEGER <<FK>>
  level : VARCHAR
  created_at : TIMESTAMPTZ
}
entity report_karma_awards {
  * report_id : BIGINT <<PK,FK>>
  user_id : INTEGER <<FK>>
  points : INTEGER
}
entity report_validations {
  * report_id : BIGINT <<PK,FK>>
  * user_id : INTEGER <<PK,FK>>
  decision : CONFIRM/REJECT
  weight : 1..5
}
entity report_denunciations {
  * report_id : BIGINT <<PK,FK>>
  * user_id : INTEGER <<PK,FK>>
  reason : VARCHAR(500), nullable
}
users ||--o{ saturation_reports
places ||--o{ saturation_reports
saturation_reports ||--o| report_karma_awards
users ||--o{ report_karma_awards
saturation_reports ||--o{ report_validations
users ||--o{ report_validations
saturation_reports ||--o{ report_denunciations
users ||--o{ report_denunciations
note bottom of saturation_reports
  HU6 consulta bloques Lima, no tabla de aforos inventados.
  Permisos/duplicados también se validan en servidor.
end note
@enduml

@startuml
title R01 — reporte y karma atómicos
actor Ciudadano
participant ReportPlaceSheet as UI
participant SaturationReportService as Service
participant SaturationReportRepository as Repo
database PostgreSQL as DB
Ciudadano -> UI : seleccionar nivel / enviar
UI -> Service : POST JWT, placeId, level
Service -> Repo : usuario, versión, expiración, regla10/3
Repo -> DB : BEGIN / usuario FOR UPDATE
Repo -> DB : revalidar sesión / lock usuario-lugar
Repo -> DB : consultar lugar y cooldown con reloj SQL
alt aceptado
  Repo -> DB : INSERT reporte / INSERT ledger único / UPDATE karma
  Repo -> DB : COMMIT
  Repo --> Service : reporte + premio real
  Service --> UI : 201
else inválido, duplicado o fallo
  Repo -> DB : ROLLBACK o sin escritura
  Repo --> Service : error público / 409
  Service --> UI : sin premio
end
note over UI
  Sin doble envío; no cerrar durante petición.
  Respuesta de otra sesión se descarta.
end note
@enduml
