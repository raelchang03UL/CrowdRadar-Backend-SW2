PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crowdradar_dev
DB_USER=postgres
DB_PASSWORD=reemplazar_con_clave_local
JWT_SECRET=reemplazar_con_secreto_largo_y_aleatorio
# Flutter Web local. Solo orígenes exactos, sin rutas ni comodín.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://[::1]:5500
# Base confiable del enlace. Por sí sola no habilita envío.
# En producción se exige HTTPS; HTTP solo loopback en desarrollo/pruebas locales.
# Comillas obligatorias: sin ellas dotenv trata "#/reset-password" como comentario.
PASSWORD_RESET_URL="http://localhost:5500/#/reset-password"
# Correo de recuperación por SMTP (Brevo). Sin estas variables, /password/forgot responde 503 uniforme.
# Brevo: SMTP & API -> SMTP -> login y clave SMTP propios de cada integrante. Usar el host sendinblue:
# el certificado del relay sudamericano no incluye smtp-relay.brevo.com y la conexión se rechaza.
# SMTP_HOST=smtp-relay.sendinblue.com
# SMTP_PORT=587
# SMTP_USER=login_smtp@smtp-brevo.com
# SMTP_PASSWORD=clave_smtp_de_brevo
# Obligatorio con Brevo: remitente verificado en Senders (el login SMTP no es una dirección válida).
# MAIL_FROM=CrowdRadar <remitente_verificado@ejemplo.com>

PASSWORD_RESET_URL=http://localhost:5500/#/reset-password
REPORT_COOLDOWN_MINUTES=3
DB_SSL=false
# Opcionales para un entorno futuro autorizado; no conectarse a Supabase.
# DATABASE_URL tiene precedencia sobre DB_*; no añadir sslmode/ssl a la URL.
# DATABASE_URL=
# DB_SSL_CA=certificado_CA_con_saltos_escapados
# Usuario demo opcional: suministrar DEMO_USER_EMAIL y DEMO_USER_PASSWORD
# solo en la sesión local, sin credenciales predeterminadas ni publicadas.
