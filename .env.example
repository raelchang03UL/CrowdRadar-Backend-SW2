PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crowdradar_dev
DB_USER=postgres
DB_PASSWORD=reemplazar_con_clave_local
JWT_SECRET=reemplazar_con_secreto_largo_y_aleatorio
# Flutter Web local. Solo orígenes exactos, sin rutas ni comodín.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://[::1]:5500
# Base confiable del enlace. No habilita envío: proveedor/remitente siguen pendientes.
# En producción se exige HTTPS; HTTP solo loopback en desarrollo/pruebas locales.
PASSWORD_RESET_URL=http://localhost:5500/#/reset-password
DB_SSL=false
# Alertas de saturación (HU 8.3). Configura un secreto aleatorio de al menos 32 caracteres
# para autenticar a la fuente interna que reporta cambios; nunca lo publiques.
SATURATION_EVENT_SECRET=
# FCM usa Application Default Credentials. La cuenta de servicio debe permanecer fuera del repo.
FCM_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\privada\firebase-service-account.json
# Opcionales para un entorno futuro autorizado; no conectarse a Supabase.
# DATABASE_URL tiene precedencia sobre DB_*; no añadir sslmode/ssl a la URL.
# DATABASE_URL=
# DB_SSL_CA=certificado_CA_con_saltos_escapados
# Usuario demo opcional: suministrar DEMO_USER_EMAIL y DEMO_USER_PASSWORD
# solo en la sesión local, sin credenciales predeterminadas ni publicadas.
