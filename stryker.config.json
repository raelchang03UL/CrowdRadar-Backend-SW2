{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing (PPT Semana 11): evalúa si las pruebas unitarias detectan cambios deliberados en la lógica de negocio pura.",
  "testRunner": "command",
  "commandRunner": { "command": "npm run test:unit" },
  "coverageAnalysis": "off",
  "mutate": [
    "src/utils/passwordPolicy.js",
    "src/utils/normalization.js",
    "src/domain/administration.js",
    "src/services/SaturationReportService.js",
    "src/services/ReportValidationService.js:1-44",
    "src/services/SaturationQueryService.js:1-53"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "thresholds": { "high": 85, "low": 70, "break": 60 },
  "concurrency": 8,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
